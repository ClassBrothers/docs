---
import '../styles/global.css';
import bodyFont from '../assets/fonts/source-sans-3-latin-wght-normal.woff2?url';
import { site, nav } from '../site';
import CrisisBox from '../components/CrisisBox.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  crisisInMain?: boolean;
  noindex?: boolean;
}
const { title, description, path, jsonLd = [], crisisInMain = false, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-image.png', site.url).href;
const withSuffix = `${title} | ${site.name}`;
const fullTitle = withSuffix.length <= 60 ? withSuffix : title;

const graph = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: 'de-DE',
    publisher: { '@id': `${site.url}/#org` },
  },
  {
    '@type': 'Organization',
    '@id': `${site.url}/#org`,
    name: site.operator,
    url: `${site.url}/`,
  },
  ...jsonLd,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#fbf7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1819" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={ld} />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav class="nav-desktop" aria-label="Hauptnavigation">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
        <details class="nav-mobile">
          <summary aria-label="Menü öffnen">Menü</summary>
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </details>
      </div>
    </header>
    <main id="inhalt">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        {!crisisInMain && <CrisisBox />}
        <div class="footer-cols">
          <div>
            <h2>Beratungsformen</h2>
            <ul>
              <li><a href="/systemische-einzelberatung-koeln/">Einzelberatung</a></li>
              <li><a href="/systemische-paarberatung-koeln/">Paarberatung</a></li>
              <li><a href="/systemische-familienberatung-koeln/">Familienberatung</a></li>
            </ul>
          </div>
          <div>
            <h2>Orientierung</h2>
            <ul>
              <li><a href="/beratung-oder-therapie/">Beratung oder Therapie</a></li>
              <li><a href="/kosten/">Kosten</a></li>
              <li><a href="/hilfe-in-koeln/">Hilfe in Köln</a></li>
              <li><a href="/beraterin-finden/">Beraterin finden</a></li>
            </ul>
          </div>
          <div>
            <h2>Portal</h2>
            <ul>
              <li><a href="/ueber-mich/">Über dieses Portal</a></li>
              <li><a href="/kontakt/">Kontakt</a></li>
              <li><a href="/impressum/">Impressum</a></li>
              <li><a href="/datenschutz/">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-small">
          Unabhängige Information, keine Beratung und keine Therapie. Ersetzt keine ärztliche oder psychotherapeutische Abklärung.
          <br />
          Umsetzung: <a href="https://class-brothers.com/seo-agentur" rel="noopener">Class Brothers GmbH</a>
        </p>
      </div>
    </footer>
  </body>
</html>
