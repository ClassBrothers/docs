---
const { items } = Astro.props as { items: { name: string; href: string }[] };
---
<nav class="crumbs" aria-label="Brotkrumen">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
