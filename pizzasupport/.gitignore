# Geheimnisse und laufender Betrieb gehören nicht ins Repository.
.env
storage/db/*.sqlite
storage/db/*.sqlite-wal
storage/db/*.sqlite-shm
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep

# Selbst gehostete Schriftdateien sind lizenzpflichtig und werden beim
# Deployment abgelegt, nicht eingecheckt. Siehe public/assets/fonts/LIESMICH.md
public/assets/fonts/*.woff2

.DS_Store
Thumbs.db
