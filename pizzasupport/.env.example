# ---------------------------------------------------------------------------
# pizzasupport.de – Umgebungsvariablen
# Diese Datei nach .env kopieren und ausfuellen. .env gehoert NICHT ins Repo.
# ---------------------------------------------------------------------------

# prod oder dev. In dev werden PHP-Fehler angezeigt, in prod nur geloggt.
APP_ENV=prod

# Basis-URL ohne abschliessenden Slash. Wird fuer Canonicals, OG-Tags,
# Sitemap und die QR-Weiterleitungen gebraucht.
APP_URL=https://pizzasupport.de

# Pfad zur SQLite-Datei. Muss ausserhalb des Web-Roots liegen.
# Relativ zum Projektverzeichnis oder absolut.
DB_PATH=storage/db/pizzasupport.sqlite

# 32 Byte, base64-kodiert. Verschluesselt Telefonnummern und Rechnungsdaten.
# Erzeugen mit:  php bin/keygen.php
# ACHTUNG: Wird der Schluessel getauscht, sind alte Datensaetze nicht mehr lesbar.
APP_KEY=

# Absender und Empfaenger der Systemmails
MAIL_FROM=noreply@pizzasupport.de
MAIL_FROM_NAME="Pizza Support"
MAIL_TO_OPS=hallo@pizzasupport.de

# Admin-Zugang fuer den Freigabe-Workflow unter /admin
# Hash erzeugen mit:  php bin/adminpass.php "deinPasswort"
ADMIN_USER=admin
ADMIN_PASS_HASH=

# Zusatz-Salt fuer die gehashten Besucher-Kennungen (Rate-Limit, Statistik).
# Wird taeglich mit dem Datum kombiniert, sodass keine Wiedererkennung moeglich ist.
HASH_SALT=
